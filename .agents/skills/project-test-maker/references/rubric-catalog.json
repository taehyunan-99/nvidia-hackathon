      "allowed_delivery_forms": ["library"],
      "criteria": [
        {"id": "public_api", "name": "Public API and behavior contracts", "relative_weight": 25},
        {"id": "versioning", "name": "Semantic versioning and compatibility", "relative_weight": 25},
        {"id": "runtime_matrix", "name": "Runtime and platform matrix", "relative_weight": 25},
        {"id": "packaging_examples", "name": "Packaging and executable examples", "relative_weight": 25}
