      "allowed_delivery_forms": ["hosted", "local", "hybrid", "library", "cli", "worker", "data_pipeline", "client"],
      "criteria": [
        {"id": "engine_semantics", "name": "Real-engine constraints and isolation", "relative_weight": 25},
        {"id": "schema_evolution", "name": "Schema evolution and compatibility", "relative_weight": 25},
        {"id": "rollback_recovery", "name": "Migration rollback and recovery", "relative_weight": 25},
        {"id": "data_preservation", "name": "Data preservation and invariant checks", "relative_weight": 25}
      ]
