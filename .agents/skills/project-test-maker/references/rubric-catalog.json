    {
      "id": "async_event_time",
      "name": "Async, event, and time",
      "allowed_delivery_forms": ["hosted", "local", "hybrid", "library", "cli", "worker", "data_pipeline", "client"],
      "criteria": [
        {"id": "idempotency", "name": "Idempotency and duplicate delivery", "relative_weight": 25},
        {"id": "ordering_retry", "name": "Ordering, retry, timeout, and DLQ behavior", "relative_weight": 25},
        {"id": "virtual_time", "name": "Virtual time and expiry behavior", "relative_weight": 25},
        {"id": "restart_replay", "name": "Restart, replay, and partial-failure recovery", "relative_weight": 25}
