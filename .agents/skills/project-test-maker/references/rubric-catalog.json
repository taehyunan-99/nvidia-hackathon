      "allowed_delivery_forms": ["hosted", "hybrid", "worker", "data_pipeline"],
      "criteria": [
        {"id": "schema_lineage", "name": "Schema evolution and lineage", "relative_weight": 25},
        {"id": "replay_backfill", "name": "Replay and backfill behavior", "relative_weight": 25},
        {"id": "partial_failure", "name": "Partial failure and restart", "relative_weight": 25},
        {"id": "data_quality", "name": "Data-quality invariants", "relative_weight": 25}
      ]
    },
    {
      "id": "performance_recovery",
      "name": "Performance, concurrency, and recovery",
      "allowed_delivery_forms": ["hosted", "local", "hybrid", "library", "cli", "worker", "data_pipeline", "client"],
      "criteria": [
        {"id": "limits", "name": "Resource and workload limits", "relative_weight": 25},
        {"id": "concurrency", "name": "Concurrency and race behavior", "relative_weight": 25},
        {"id": "restart", "name": "Restart and degraded-mode behavior", "relative_weight": 25},
        {"id": "recovery", "name": "Backup, restore, and recovery invariants", "relative_weight": 25}
      ]
    }
  ]
}
