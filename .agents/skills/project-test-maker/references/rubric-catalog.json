      "allowed_delivery_forms": ["hosted", "local", "hybrid", "client"],
      "criteria": [
        {"id": "critical_journeys", "name": "Critical user journeys", "relative_weight": 25},
        {"id": "state_restoration", "name": "State restoration and interrupted flows", "relative_weight": 25},
        {"id": "accessibility_input", "name": "Accessibility and input modalities", "relative_weight": 25},
        {"id": "environment_matrix", "name": "Supported client environment matrix", "relative_weight": 25}
      ]
    },
    {
