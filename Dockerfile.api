FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH=/app/.venv/bin:$PATH

WORKDIR /app

RUN pip install --no-cache-dir uv==0.11.16
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

# Offline structure calculations use the analysis team's pinned dependencies.
COPY docs/topics/her2/assets/a02/requirements.txt /tmp/analysis-requirements.txt
RUN uv pip install --python /app/.venv/bin/python -r /tmp/analysis-requirements.txt

COPY service ./service
COPY logic ./logic
COPY docs/frontend-hosting/contracts/service.schema.json ./docs/frontend-hosting/contracts/service.schema.json
COPY frontend/public/structures ./frontend/public/structures
COPY docs/frontend-hosting/assets/3d-research/verified-structures.json ./docs/frontend-hosting/assets/3d-research/verified-structures.json
COPY docs/topics/her2/assets ./docs/topics/her2/assets

RUN mkdir /data && chown 10001:10001 /data
USER 10001:10001

CMD ["uvicorn", "service.operational:from_environment", "--factory", "--host", "0.0.0.0", "--port", "8000"]
