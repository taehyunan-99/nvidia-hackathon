# Copy to .env.aws.local (ignored), chmod 600. Never paste resolved config into logs.
# Build linux/amd64 images from the merged main commit and record immutable image IDs.
API_IMAGE=
WEB_IMAGE=
POSTGRES_PASSWORD=
# CloudFront's actual generated hostname; no scheme in SITE_ADDRESS.
SITE_ADDRESS=
PUBLIC_ORIGIN=
# Only after the EC2 security group permits CloudFront origin traffic, not all IPs.
WEB_BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
ORIGIN_VERIFY_SECRET=
# Start with mock for public HTTPS/session tests, then explicitly select live.
DATA_MODE=mock
NVIDIA_API_KEY=
LOGIC_AGENT_MODE=nat
PDB_SEARCH_ENABLED=1
# Per analysis, including retries. Boltz-2 is capped at 4 in logic/call_budget.py.
NEMOTRON_REQUEST_LIMIT=40
# Leave empty for per-run limits; do not reset/reuse the exhausted internal test counter.
MODEL_BUDGET_PATH=
# Across all runs, resets by Korea calendar date; usage history persists through restarts.
NEMOTRON_DAILY_REQUEST_LIMIT=4000
BOLTZ2_DAILY_REQUEST_LIMIT=200
MAX_SESSION_RUNS=1
MAX_ACTIVE_RUNS=10
ANALYSIS_TIMEOUT_SECONDS=1200
MAX_SESSIONS=100
MAX_SESSION_REVIEWS=10
MAX_STORAGE_BYTES=1073741824
MAX_REQUEST_BYTES=22020096
REQUESTS_PER_MINUTE=120
