# 이 파일을 .env로 복사해 값을 채운다. .env는 .gitignore가 막고 있다.
#   cp .env.example .env
#
# 실제 키를 이 예제 파일에 넣지 않는다 (CONTRIBUTING.md).
# 확인:  python -m logic.check_key
# 발급:  https://build.nvidia.com/settings/api-keys  (로그인 필요)

# build.nvidia.com에서 발급한 키. nvapi- 로 시작한다.
# 팀원마다 각자 키를 쓴다. 공유하거나 채팅·이슈에 붙여넣지 않는다.
NVIDIA_API_KEY=

# 비우면 모델 목록에서 nemotron 계열을 고른다.
NEMOTRON_MODEL=

# 정식 접수 API용 설정. 시연용 service.app에는 적용되지 않는다.
DATABASE_URL=
SERVICE_DATA_ROOT=
DATA_MODE=mock
SECURE_COOKIE=false
ALLOWED_ORIGINS=
MAX_UPLOAD_BYTES=20971520

# 로컬 Docker Compose 전용. 영숫자 비밀번호를 로컬 env 파일에 설정한다.
POSTGRES_PASSWORD=
WEB_PORT=8080

# Disable only automatic public structure search (explicit PDB sources still resolve).
PDB_SEARCH_ENABLED=1

# Local rehearsal limits; public limits require representative workload verification.
MAX_SESSION_RUNS=1
MAX_ACTIVE_RUNS=10
ANALYSIS_TIMEOUT_SECONDS=1200

# Local resource guards: global mutation rate, active sessions, reviews/session, DB+file high water.
MAX_SESSIONS=100
MAX_SESSION_REVIEWS=10
MAX_STORAGE_BYTES=1073741824
MAX_REQUEST_BYTES=22020096
REQUESTS_PER_MINUTE=120
