# Copy to .env.server.local (Git ignored), chmod 600, and generate a hex password.
POSTGRES_PASSWORD=
# Build locally for rehearsal; use recorded image digests for a real deployment.
API_IMAGE=her2-api:server-check
WEB_IMAGE=her2-web:server-check
# Domain-free rehearsal only: local CA, not a publicly trusted certificate.
SITE_ADDRESS=localhost
PUBLIC_ORIGIN=https://localhost:8443
WEB_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8081
HTTPS_PORT=8443
# Set DATA_MODE=live to run the persisted analysis worker after local checks.
DATA_MODE=mock
# Supply NVIDIA_API_KEY from your private environment for model/prediction calls.
NVIDIA_API_KEY=
LOGIC_AGENT_MODE=nat
# Public HTTPS later requires a real hostname, exact origin, ports 80/443,
# and separate admission controls plus actual analysis integration.

# Disable only automatic public structure search (explicit PDB sources still resolve).
PDB_SEARCH_ENABLED=1

# Local rehearsal limits; public limits require representative workload verification.
MAX_SESSION_RUNS=1
MAX_ACTIVE_RUNS=10
ANALYSIS_TIMEOUT_SECONDS=1200

# Local resource guards: global mutation rate, active sessions, reviews/session, DB+file high water.
MAX_SESSIONS=100
MAX_SESSION_REVIEWS=10
MAX_STORAGE_BYTES=1073741824
MAX_REQUEST_BYTES=22020096
REQUESTS_PER_MINUTE=120
